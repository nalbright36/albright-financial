# Copy to .env and fill in. Never commit .env. Every name marked (required) has
# no default: the app refuses to start without it (settings.required_env).

# Django (required). Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Encryption key for stored Alpaca credentials and the Gmail token (required).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALPACA_CREDENTIALS_ENCRYPTION_KEY=
# Only while rotating keys: the previous key(s), comma-separated. Remove after rotate_encryption_key.
ALPACA_CREDENTIALS_ENCRYPTION_OLD_KEYS=

# Local development only (both off by default). SERVE_STATIC_LOCALLY=1 makes `runserver`
# serve the CSS/JS without DEBUG; DJANGO_DEBUG=1 turns on Django's debug pages - never on the live site.
# SERVE_STATIC_LOCALLY=1
# DJANGO_DEBUG=1

# Database (all required)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=

# Anthropic (resume chatbot)
ANTHROPIC_API_KEY=
# RESUME_AI_MODEL=   (optional - leave commented to use the default in settings.py)

# GoldAPI
GOLDAPI_KEY=

# eBay (comparables)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub (optional, read-only search rate limit)
GITHUB_TOKEN=

# Google OAuth client for the Opportunities "Email alerts" source (gmail.readonly)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public site address used in Telegram links (e.g. https://www.example.com)
# SITE_BASE_URL=   (optional - leave commented to use the default)
